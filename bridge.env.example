# Copy outside the repository and chmod 600. Values are literal; no shell expansion.
# Same host as Paseo:
PASEO_URL=ws://127.0.0.1:6767/ws
# For a remote daemon on macOS, use your existing SSH forward instead:
# PASEO_URL=ws://127.0.0.1:16767/ws
# PASEO_PASSWORD=your-daemon-password
# PASEO_DB=/absolute/private/path/events.sqlite
PASEO_POLL_MS=30000
PASEO_HTTP_PORT=18767
PASEO_OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
PASEO_OAUTH_RESOURCE=https://api.openai.com/v1/mcp/tunnel_YOURID
PASEO_OAUTH_SUBJECT=google-oauth2|YOUR-EXACT-USER-ID
CONTROL_PLANE_TUNNEL_ID=tunnel_YOURID
CONTROL_PLANE_API_KEY=REPLACE-WITH-YOUR-RESTRICTED-RUNTIME-KEY

# Opt in to additional scope groups; default remains read-only:
PASEO_ACCESS=read
# PASEO_ACCESS=read,control,admin
